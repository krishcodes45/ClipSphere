# ClipSphere Express Server Environment Variables
PORT=5000
ELECTRON_HOST=http://localhost:5173
NEXT_API_HOST=http://localhost:3000/api/

# AWS S3 Cloud Storage
BUCKET_NAME=mindshare-ai
ACCESS_KEY=your_aws_access_key
SECRET_KEY=your_aws_secret_key
BUCKET_REGION=eu-north-1

# Generative AI (Google Gemini Flash)
GEMINI_API_KEY=your_gemini_api_key_from_aistudio
GEMINI_MODEL=gemini-3.8-flash

# Google Cloud Speech-to-Text Path (Optional, falls back to Gemini audio model)
GOOGLE_APPLICATION_CREDENTIALS=./clipsphere-key.json
